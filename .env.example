# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_BRAND_NAME=M.M Bags
NEXT_PUBLIC_WHATSAPP_NUMBER=+201229749608

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paymob (Phase 2)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_COD=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Twilio WhatsApp (Phase 3)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM= # production: whatsapp:+<approved WABA sender>. NEVER use the +14155238886 sandbox in prod — the code refuses to send if it sees that value with NODE_ENV=production.

# Email (Phase 3)
RESEND_API_KEY=
EMAIL_FROM=marco@mmbags.com

# Admin
ADMIN_EMAIL=marco@mmbags.com

# InstaPay (manual transfer flow)
# Handle customers transfer to. When unset, the InstaPay option is
# hidden at checkout entirely.
NEXT_PUBLIC_INSTAPAY_HANDLE=
# Share link generated INSIDE the InstaPay app (Profile -> share /
# payment link, looks like https://ipn.eg/S/<handle>/instapay/<code>).
# Never construct this URL by hand — the trailing code is app-generated.
# When unset, the "Open InstaPay" button + QR are hidden and the manual
# copy-the-handle flow remains.
NEXT_PUBLIC_INSTAPAY_SHARE_LINK=
# BUSINESS hours before an unpaid InstaPay order is auto-cancelled +
# restocked (default 2, min 1, max 48). Server-only. Only time inside
# business hours (11:00-22:00 Africa/Cairo, every day) counts toward
# the window, and expiry itself only runs during business hours — the
# accounting happens inside the DB function (migration 0015).
INSTAPAY_ORDER_EXPIRATION_BUSINESS_HOURS=2

# Vercel Cron auth — Vercel sends `Authorization: Bearer <CRON_SECRET>`
# to /api/cron/* when this is set. The expiry endpoint refuses to run
# without it (fail closed). Generate any long random string.
CRON_SECRET=
